# Voice Route Planner Environment Variables
# Copy this file to .env and fill in your actual values

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_OAUTH_SECRET_NAME=voice-route-planner/google-oauth
GEMINI_API_KEY=your-gemini-api-key-here

# News API Key
# Get this from: https://newsapi.org/
NEWS_API_KEY=your-news-api-key-here

# Production URL (optional for local development)
# This will be auto-configured in Amplify Console for production
AMPLIFY_APP_URL=https://your-app-url.amplifyapp.com